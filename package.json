{
  "name": "ebm-firebase",
  "private": true,
  "version": "4.3.0",
  "description": "শাখা ব্যয়-বাজেট ম্যানেজার — Firebase সংস্করণ (শুধু টেস্টের জন্য; সফটওয়্যার চালাতে npm লাগে না)",
  "type": "module",
  "scripts": {
    "test:rules": "firebase emulators:exec --only firestore --project demo-ebm \"node --test tests/rules.test.mjs\"",
    "emu": "firebase emulators:start --only auth,firestore --project demo-ebm"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^3.0.4",
    "firebase": "^10.14.1"
  }
}
